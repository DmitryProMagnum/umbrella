---
import { Picture } from 'astro:assets';
import { home } from '../content/home';
import SplitText from './SplitText.astro';
import signal from '../assets/img/signal.jpg';

const s = home.people;
const c = s.card;
const R = 48;
const C = 2 * Math.PI * R; // 301.59
const onTime = (C * c.onTime) / 100;
---
<section class="section bg-light on-light" id="people" aria-labelledby="people-title">
  <div class="container split">
    <SplitText id="people" label={s.label} title={s.title} lead={s.lead} points={s.points} more={s.more} />

    <div class="split__visual" data-reveal>
      <div class="fit" data-fit="760" data-fit-min="768" data-fit-max="1.25">
        <div class="fit__canvas vcanvas vpeople">
          <div class="parallax-media">
            <Picture src={signal} widths={[400, 760, 1140, 1520]} sizes="(min-width: 1200px) 760px, (min-width: 768px) 90vw, 100vw" formats={['avif', 'webp']} alt="" loading="lazy" data-parallax="0.08" />
          </div>

          <div class="card-ui report float float--slow" aria-hidden="true" data-anim data-donut>
            <div class="req__head">
              <div>
                <div class="req__title">{c.title}</div>
                <div class="req__meta">{c.meta}</div>
              </div>
              <span class="status status--line d-only">{c.period}</span>
            </div>
            <div class="report__donut-row">
              <div class="donut">
                <svg viewBox="0 0 120 120">
                  <circle cx="60" cy="60" r={R} fill="none" stroke="#0A0A0A" stroke-width="16" />
                  <circle class="donut__arc" cx="60" cy="60" r={R} fill="none" stroke="#22F2CF" stroke-width="16" transform="rotate(-90 60 60)" stroke-dasharray={`${onTime.toFixed(2)} ${C.toFixed(2)}`} data-dash={onTime.toFixed(2)} data-circ={C.toFixed(2)} />
                </svg>
                <div class="donut__center"><b>{c.donutValue}</b><span>{c.donutLabel}</span></div>
              </div>
              <div class="legend">
                {c.legend.map((l) => (
                  <div class="legend__row">
                    <span class:list={['legend__sw', { 'legend__sw--mint': l.mint }]}></span>
                    <span><span class="d-only">{l.label}</span><span class="m-only">{l.labelMobile}</span></span>
                    <span class="legend__v">{l.value}</span>
                  </div>
                ))}
              </div>
            </div>
            <div>
              <div class="report__tasks-t">{c.tasksTitle}</div>
              <div class="report__tasks">
                {c.tasks.map((t) => (
                  <div class="task-row">
                    <div>
                      <div class="task-row__t"><span class="d-only">{t.title}</span><span class="m-only">{t.titleMobile}</span></div>
                      <div class="task-row__d d-only">{t.due}</div>
                    </div>
                    <span class:list={['status', t.late ? 'status--late' : 'status--mint']}>{t.late ? c.lateLabel : c.onTimeLabel}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
