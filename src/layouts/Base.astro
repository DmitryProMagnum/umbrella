---
import '../styles/global.css';
import '../styles/scroll.css';
import '../styles/motion.css';
import { getContent } from '../content';
const home = getContent(Astro.currentLocale);
import { analytics } from '../lib/analytics';

interface Props {
  /** картинки первого экрана для предзагрузки (media — чтобы телефон не качал десктопную) */
  preloadImages?: { href: string; media?: string; type?: string }[];
  ogImage?: string;
  /** заголовок вкладки для внутренних страниц (по умолчанию — из meta) */
  title?: string;
  description?: string;
  /** есть ли у страницы версия на другом языке (для hreflang) */
  translated?: boolean;
}
const { preloadImages = [], ogImage, title, description, translated = true } = Astro.props;
const { meta, ui, locale } = home;
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://umbrellacorp.ai';
const canonical = new URL(Astro.url.pathname, site).toString();
// та же страница на другом языке: /privacy ⇄ /en/privacy
const path = Astro.url.pathname;
const ruPath = locale === 'en' ? path.replace(/^\/en(\/|$)/, '/') : path;
const enPath = locale === 'en' ? path : `/en${path === '/' ? '/' : path}`;
const alternates = !translated ? [] : [
  { lang: 'ru', href: new URL(ruPath, site).toString() },
  { lang: 'en', href: new URL(enPath, site).toString() },
];
const ogImageAbs = ogImage ? new URL(ogImage, site).toString() : undefined;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Umbrellacorp',
    url: site,
    logo: `${site}/favicon.svg`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Umbrella AI',
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'ERP',
    operatingSystem: 'Web',
    url: site,
    description: meta.description,
    inLanguage: locale,
    publisher: { '@type': 'Organization', name: 'Umbrellacorp' },
  },
];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? meta.title}</title>
    <meta name="description" content={description ?? meta.description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    <meta name="theme-color" content="#000000" />
    {analytics.ymId && <meta name="ym-id" content={analytics.ymId} />}
    <meta name="color-scheme" content="dark light" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={`/fonts/inter-tight-${locale === 'en' ? 'latin' : 'cyrillic'}-wght-normal.woff2`} as="font" type="font/woff2" crossorigin />
    {preloadImages.map((im) => (
      <link rel="preload" as="image" href={im.href} media={im.media} type={im.type} fetchpriority="high" />
    ))}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'ru_RU' : 'en_US'} />
    <meta property="og:site_name" content={meta.siteName} />
    <meta property="og:title" content={title ?? meta.ogTitle} />
    <meta property="og:description" content={description ?? meta.description} />
    <meta property="og:url" content={canonical} />
    {ogImageAbs && <meta property="og:image" content={ogImageAbs} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!-- класс .js включает анимации появления; без JS контент виден сразу -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    {analytics.ymId && (
      <script is:inline define:vars={{ id: analytics.ymId }}>
        (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');
        ym(id,'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:false});
      </script>
    )}
    {analytics.gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.gaId}`} />}
    {analytics.gaId && (
      <script is:inline define:vars={{ id: analytics.gaId }}>
        window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;gtag('js',new Date());gtag('config',id);
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skip}</a>
    <slot />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
